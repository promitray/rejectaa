# API the app calls directly for tools and admin routes.
# Local:
VITE_API_URL=http://localhost:8000
# Production (Railway):
# VITE_API_URL=https://rejecta-production.up.railway.app

# Auth routes (login, refresh, logout…) go through a same-origin proxy so the
# refresh cookie is first-party: Vite in dev (vite.config.ts), Netlify in
# production (netlify.toml). Leave as is unless you change those proxies.
VITE_AUTH_BASE=/api/auth

# Marketing site. Leave unset until rejecta.ai exists.
# When set, "How it works" in the app header goes there.
# VITE_MARKETING_URL=https://rejecta.ai
