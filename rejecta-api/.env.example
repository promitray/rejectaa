LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
HF_MODEL_NAME=mistralai/Mistral-7B-Instruct-v0.3
HF_API_TOKEN=
HF_USE_LOCAL=false

# "production" turns on strict checks: the API refuses to start with unsafe
# settings (see config.Settings.production_problems).
ENVIRONMENT=development
# Swagger UI and /openapi.json. Must be false in production.
DOCS_ENABLED=true

# App origin. Locally this is the Vite app. In production, app.rejecta.ai.
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5173
# Extra browser origins, comma-separated. localhost and app.rejecta.ai are always allowed.
CORS_ORIGINS=

# Marketing site. Does not call this API.
MARKETING_URL=https://rejecta.ai

# --- Database (Supabase Postgres, schema "app") ---------------------------
# Owner connection, used ONLY by Alembic and scripts (never by the API).
# Supabase Dashboard -> Connect -> Direct connection (IPv6) or Session pooler
# (IPv4, needed on Railway). Special characters in the password (@ / # %)
# are handled automatically; a literal % must be written as %25.
MIGRATION_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Runtime connection as the least-privilege role rejecta_api.
# Generated by: python -m scripts.db_role --write-env
DATABASE_URL=
# require for Supabase; disable only for a local test Postgres.
DB_SSL_MODE=require
DB_POOL_MIN_SIZE=1
DB_POOL_MAX_SIZE=10

# --- Auth (own JWT) --------------------------------------------------------
# Generate with: python -m scripts.generate_keys --write-env  (never commit)
JWT_PRIVATE_KEY=
JWT_KEY_ID=
# Old public keys still accepted during rotation: kid:base64url,kid2:...
JWT_PREVIOUS_PUBLIC_KEYS=
JWT_ISSUER=https://rejecta-production.up.railway.app
JWT_AUDIENCE=rejecta-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
SESSION_MAX_LIFETIME_DAYS=90
# Refresh cookie. Browser reaches auth via the Netlify/Vite proxy at /api/auth.
AUTH_COOKIE_PATH=/api/auth
# true in production (HTTPS). false only for local http development.
AUTH_COOKIE_SECURE=true
# Optional: Netlify signed-proxy secret, to trust the client IP from Netlify.
NETLIFY_PROXY_SECRET=
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# --- Admin two-factor (TOTP) ------------------------------------------------
# Fernet key; encrypts TOTP secrets and keys recovery-code hashes.
# Generated by scripts.generate_keys. Do NOT rotate casually: every admin
# would have to re-enroll (python -m scripts.create_admin --reset-mfa).
MFA_ENCRYPTION_KEY=
MFA_ISSUER_NAME=Rejecta
MFA_TOKEN_TTL_MINUTES=5
